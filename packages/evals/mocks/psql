#!/usr/bin/env bash
# Mock psql for eval environments.
# Accepts any arguments and returns an empty result set.
set -euo pipefail

# If -c is used (inline command), print column headers for a SELECT
for arg in "$@"; do
  if [[ "$arg" == "-c" ]]; then
    echo "(0 rows)"
    exit 0
  fi
done

# Default: succeed silently
exit 0
