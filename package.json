{
	"name": "supabase-agent-skills",
	"version": "1.0.0",
	"author": "Supabase",
	"license": "MIT",
	"description": "Official Supabase agent skills",
	"scripts": {
		"build": "pnpm --filter skills-build run build",
		"validate": "pnpm --filter skills-build run validate",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"check": "biome check --write .",
		"ci:check": "biome ci .",
		"test": "vitest run",
		"test:sanity": "vitest run test/sanity.test.ts",
		"evals:run": "tsx --env-file-if-exists=.env evals/main.ts",
		"evals:build": "docker build -t evals-claude evals/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/node": "^24.0.0",
		"tsx": "^4.21.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
